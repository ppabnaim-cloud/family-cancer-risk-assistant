# Copy to .env.local for local development (vercel dev).
# In production these are set in Vercel → Settings → Environment Variables.
# NEVER commit real values — .env.local is gitignored.

# Feedback form → EmailJS
EMAILJS_SERVICE_ID=service_xxxxxxx
EMAILJS_TEMPLATE_ID=template_xxxxxxx
EMAILJS_PUBLIC_KEY=your_emailjs_public_key
EMAILJS_PRIVATE_KEY=your_emailjs_private_key

# Optional. Only used if your EmailJS template's "To Email" field is {{to_email}}.
FEEDBACK_TO_EMAIL=nurulamieraasli@gmail.com

# ------------------------------------------------------------------
# Research data collection — see src/collection.js for the data model
# ------------------------------------------------------------------
# Collection is OFF unless BOTH flags below are "true". The VITE_ flag
# controls the UI (consent screen, participant code); COLLECTION_ENABLED
# is what actually authorises a write, and the server refuses every
# request without it. A tampered front end cannot bypass that.
#
# DO NOT enable either until MREC/NMRR approval is granted.

# --- Client (build-time, Vite) ---
VITE_COLLECT_ENABLED=false
VITE_NMRR_ID=
VITE_MREC_REF=
VITE_DATA_CONTROLLER=Institut Kanser Negara (IKN), Kementerian Kesihatan Malaysia
VITE_DATA_CONTACT=
VITE_RETENTION_YEARS=7

# --- Server (runtime) ---
# Set COLLECTION_ENABLED, then exactly ONE destination below. The server picks
# whichever is configured, preferring Sheets, then Apps Script, then email.
COLLECTION_ENABLED=false
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the PEM with literal \n in place of newlines, wrapped in quotes.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
SHEETS_SPREADSHEET_ID=
SHEETS_TAB_NAME=Submissions

# --- Destination B: Apps Script Web App (no Google Cloud Platform needed) ---
# Deploy scripts/apps-script/Code.gs from the sheet (Extensions -> Apps Script).
# Use this when your Workspace blocks console.cloud.google.com.
APPS_SCRIPT_URL=
APPS_SCRIPT_SECRET=

# --- Destination C: email fallback (reuses the EmailJS service above) ---
# Each record arrives as one email carrying a tab-separated line to paste into
# the sheet. Always works; does not scale, and summary_generated is unavailable.
RESEARCH_TO_EMAIL=
